{
  "name": "@vibedev/dsh-defaults",
  "description": "VibeDev product defaults over dsh-base: no data uploads to DeepSeek, and the model is told it runs in VibeDev",
  "version": "0.2.0-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@vibedev/dsh-account": "workspace:*",
    "@vibedev/dsh-llm-gateway": "workspace:*",
    "@vibedev/dsh-web-search-gateway": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
